{
  // Existing studio Worker. Keep secrets and per-environment variables in Cloudflare.
  "name": "egygillz-api",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  // One trigger handles bot polling, advance appointment alerts and the Cairo-noon digest.
  // Optional variable APPOINTMENT_LEAD_MINUTES: 5–180 (default: 60).
  "triggers": { "crons": ["* * * * *"] }
}
