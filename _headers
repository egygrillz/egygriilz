# ─────────────────────────────────────────────────────────────────────────────
# EGYGRILLZ — Cloudflare Pages headers
# Put this file in the repo root (Cloudflare Pages reads "_headers" automatically).
# Test after deploy: https://securityheaders.com/?q=egygrillz.com
# ─────────────────────────────────────────────────────────────────────────────

/*
  # ── Transport ──
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # ── Clickjacking / sniffing / referrer ──
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self "https://accept.paymob.com"), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

  # ── Content Security Policy ──
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://challenges.cloudflare.com https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https://raw.githubusercontent.com https://res.cloudinary.com https://*.googleusercontent.com; media-src 'self' blob: https://raw.githubusercontent.com; connect-src 'self' https://api.github.com https://raw.githubusercontent.com https://*.googleapis.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://api.emailjs.com https://api.gold-api.com https://data-asg.goldprice.org https://challenges.cloudflare.com https://*.workers.dev; frame-src 'self' https://accept.paymob.com https://challenges.cloudflare.com https://my.spline.design; form-action 'self' https://accept.paymob.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

  # ── CORS ──
  Access-Control-Allow-Origin: https://egygrillz.com

  # ── Don't leak the platform ──
  X-Powered-By: EGYGRILLZ

# ── Internal pages that must never be indexed ──
/editx
  X-Robots-Tag: noindex, nofollow, noarchive

/editx.html
  X-Robots-Tag: noindex, nofollow, noarchive

/quotes
  X-Robots-Tag: noindex, nofollow, noarchive

/quotes.html
  X-Robots-Tag: noindex, nofollow, noarchive

/invoice
  X-Robots-Tag: noindex, nofollow, noarchive

/invoice.html
  X-Robots-Tag: noindex, nofollow, noarchive

/staff-panel-x7k2
  X-Robots-Tag: noindex, nofollow, noarchive

/staff-panel-x7k2.html
  X-Robots-Tag: noindex, nofollow, noarchive

/staff-panel-x7k2/*
  X-Robots-Tag: noindex, nofollow, noarchive

/egygz-client-intake
  X-Robots-Tag: noindex, nofollow

/egygz-client-intake.html
  X-Robots-Tag: noindex, nofollow

/x
  X-Robots-Tag: noindex, nofollow, noarchive

/x.html
  X-Robots-Tag: noindex, nofollow, noarchive

/MTC
  X-Robots-Tag: noindex, nofollow, noarchive

/MTC.html
  X-Robots-Tag: noindex, nofollow, noarchive

# ── Caching: HTML revalidates, hashed assets are immutable ──
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

