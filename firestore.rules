rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() {
   return request.auth != null && request.auth.token.get('admin', false) == true
    && exists(/databases/$(database)/documents/_admins/$(request.auth.uid))
    && get(/databases/$(database)/documents/_admins/$(request.auth.uid)).data.active == true
    && request.auth.token.get('auth_time', 0) >= get(/databases/$(database)/documents/_admins/$(request.auth.uid)).data.get('minAuthTime', 0)
    && request.time.toMillis() < (request.auth.token.get('auth_time', 0) + get(/databases/$(database)/documents/_admins/$(request.auth.uid)).data.get('maxSessionSeconds',43200)) * 1000
    && (!get(/databases/$(database)/documents/_admins/$(request.auth.uid)).data.get('requireMfa', false)
      || request.auth.token.get('firebase', {}).get('sign_in_second_factor', '') == 'totp');
  }
  function schedule() {
   let d=request.resource.data;
   return d.keys().hasOnly(['openDays','openHour','closeHour','slotDuration','holidays'])
    && d.openDays is list && d.openDays.size() <= 7 && d.openDays.hasOnly([0,1,2,3,4,5,6])
    && d.openHour is int && d.openHour >= 0 && d.openHour <= 23
    && d.closeHour is int && d.closeHour >= 0 && d.closeHour <= 24
    && (d.closeHour == 0 || d.closeHour > d.openHour)
    && d.slotDuration in [15,30,60,90,120] && d.holidays is list && d.holidays.size() <= 366;
  }
  match /{category}/{id} { allow read: if category in ['golds','silvers','diamonds','latest-designs','sets']; }
  match /_admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
  match /appointments/{id} { allow read: if admin(); allow write: if false; }
  match /invoices/{id} { allow read, write: if false; }
  match /clients/{id} { allow read, delete: if admin(); allow create, update: if admin() && request.resource.data.name is string && request.resource.data.name.size() <= 100 && request.resource.data.phone is string && request.resource.data.phone.size() <= 30; }
  match /messages/{id} { allow read, delete: if admin(); allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool; }
  match /settings/schedule { allow read: if admin(); allow create, update: if admin() && schedule(); }
  match /schedule/{id} { allow read: if admin(); }
  match /{document=**} { allow read, write: if false; }
 }
}
