rules_version = '2';

/* ═══════════════════════════════════════════════════════════════════════════
 *  EGYGRILLZ — Firestore security rules
 *  ---------------------------------------------------------------------------
 *  The dashboard (/editx) and the Cloudflare Worker both sign in as a real
 *  Firebase Auth user. This file is the single place that decides who may
 *  read what.
 *
 *  Deploy it with:
 *      firebase deploy --only firestore:rules --project egygrillz-studio
 *  …or paste the whole file into
 *      Firebase console → Firestore Database → Rules → Publish
 *
 *  The one rule people trip over is `mould_orders`: it holds client phone
 *  numbers and addresses, so anonymous reads are refused. It is readable by
 *  staff only — the studio account must therefore appear in the staff list
 *  below (or be granted the `staff` custom claim).
 * ═══════════════════════════════════════════════════════════════════════════ */

service cloud.firestore {
  match /databases/{database}/documents {
    // Use a staff/admin custom claim or an explicitly trusted Auth UID.
    // Email fallback requires verification. Missing claims must not throw.
    function isStaff() {
      return request.auth != null && (
        request.auth.token.get('staff', false) == true ||
        request.auth.token.get('admin', false) == true ||
        request.auth.uid in staffUids() || (
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '') == 'admin@egygrillz.com'
        )
      );
    }
    function staffUids() {
      // Add trusted Firebase Auth UIDs here for staff or the Worker account.
      return [];
    }

    /* ── public, read-only content ─────────────────────────────────────── */
    match /settings/{docId} {
      allow get: if docId in ['pricing', 'site', 'schedule', 'catalog', 'banners', 'crops', 'visibility'];
      allow read, write: if isStaff();
    }

    /* ── studio data: staff only ───────────────────────────────────────── */
    function bookingIdMatches(id, data) {
      return id == data.date + '_' + data.time.replace('[ :]', '');
    }
    match /appointments/{docId} {
      /*
       * Public bookings must be paired atomically with their slot claim.
       * The deterministic document ID is shared with /slots/{docId}; this
       * prevents a client from claiming a slot without also recording the
       * appointment (or creating an appointment without reserving the slot).
       */
      allow create: if isStaff() || request.resource.data.keys().hasAll([
          'service', 'date', 'time', 'name', 'phone', 'email', 'notes',
          'status', 'showedUp', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'service', 'date', 'time', 'name', 'phone', 'email', 'notes',
          'status', 'showedUp', 'createdAt'
        ])
        && request.resource.data.showedUp == null
        && request.resource.data.createdAt == request.time
        && request.resource.data['name'] is string
        && request.resource.data['name'].size() > 0
        && request.resource.data['name'].size() <= 100
        && request.resource.data['phone'] is string
        && request.resource.data['phone'].size() <= 40
        && request.resource.data['email'] is string
        && request.resource.data['email'].size() <= 254
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() <= 500
        && request.resource.data['notes'] is string
        && request.resource.data['notes'].size() <= 1000
        && request.resource.data['date'] is string
        && request.resource.data['date'].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data['time'] is string
        && request.resource.data['time'].matches('(0[1-9]|1[0-2]):[0-5][0-9] [AP]M')
        && request.resource.data['status'] == 'confirmed'
        && bookingIdMatches(docId, request.resource.data)
        && !exists(/databases/$(database)/documents/slots/$(docId))
        && getAfter(/databases/$(database)/documents/slots/$(docId)).data['date'] == request.resource.data['date']
        && getAfter(/databases/$(database)/documents/slots/$(docId)).data['time'] == request.resource.data['time'];
      allow read, update, delete: if isStaff();
    }

    /*
     * Availability is non-sensitive, so visitors may read slot date/time.
     * A public slot can only be created in the same atomic transaction as a
     * matching appointment. Existing slots remain immutable to the public.
     */
    match /slots/{docId} {
      allow read: if true;
      allow create: if isStaff() || request.resource.data.keys().hasOnly(['date', 'time'])
        && request.resource.data.keys().hasAll(['date', 'time'])
        && request.resource.data['date'] is string
        && request.resource.data['date'].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data['time'] is string
        && request.resource.data['time'].matches('(0[1-9]|1[0-2]):[0-5][0-9] [AP]M')
        && bookingIdMatches(docId, request.resource.data)
        && !exists(/databases/$(database)/documents/appointments/$(docId))
        && getAfter(/databases/$(database)/documents/appointments/$(docId)).data['date'] == request.resource.data['date']
        && getAfter(/databases/$(database)/documents/appointments/$(docId)).data['time'] == request.resource.data['time'];
      allow update, delete: if isStaff();
    }

    match /clients/{docId} {
      /* the booking page creates its own client record; reading the client
         list back (names, phones, visit history) stays staff-only */
      allow create: if isStaff() || request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'totalAppointments', 'totalNoShows',
          'firstVisit', 'lastVisit', 'services', 'notes', 'createdAt'
        ]) && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.totalAppointments == 1 && request.resource.data.totalNoShows == 0
        && docId.matches('[0-9]{8,40}')
        && docId == request.resource.data.phone.replace('[^0-9]', '')
        && request.resource.data.firstVisit is string
        && request.resource.data.firstVisit.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.firstVisit == request.resource.data.lastVisit
        && request.resource.data.services is list && request.resource.data.notes == ''
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isStaff();
    }

    match /invoices/{docId} {
      allow read, write: if isStaff();
    }

    // The public calculator downloads locally. Only the studio issues/saves quotes.
    match /quotes/{docId} {
      allow read, write: if isStaff();
    }

    match /design_templates/{docId} {
      allow read, create, update, delete: if isStaff();
    }

    /* Client phone numbers and home addresses — staff only. This is the
       collection the dashboard reported as permission-denied. */
    match /mould_orders/{docId} {
      allow create: if true;          // /moulds places the order from the website
      allow read, update, delete: if isStaff();
    }

    match /messages/{docId} {
      allow create: if true;          // /contact form
      allow read, update, delete: if isStaff();
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /catalog/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Local order drafts and signatures have no public or cloud collection.
    // Paths not explicitly matched above are denied by default.
  }
}
